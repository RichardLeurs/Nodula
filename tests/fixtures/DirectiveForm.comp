<script setup>
import { signal } from 'nodula-framework';

const [name, setName] = signal('First');
const [done, setDone] = signal(false);
const [visible, setVisible] = signal(true);
let input = null;
const setInput = (element) => { input = element; };
</script>

<template>
  <section>
    <input @ref="setInput" @bind:value="name, setName" />
    <input type="checkbox" bind:checked="done, setDone" />
    <p @show="visible()">{{ name() }}: {{ done() }}</p>
    <button @on:click="setVisible(!visible())">Toggle</button>
    <button @click="setName(input.value)">Read ref</button>
  </section>
</template>