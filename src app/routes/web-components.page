    <section class="web-components-panel" aria-labelledby="iconify-heading">
      <div>
        <p class="eyebrow">External web component</p>
        <h2 id="iconify-heading">Choose an icon</h2>
        <p class="web-components-copy">Iconify loads each icon on demand. The icon name below is passed to the custom element as a property.</p>
      </div>

      <div class="web-component-icon-row" aria-label="Choose an icon">
        <button class="web-component-icon-button" type="button" aria-label="Select rocket icon" @click="selectIcon('mdi:rocket-launch')">
          <iconify-icon icon="mdi:rocket-launch" aria-hidden="true"></iconify-icon>
        </button>
        <button class="web-component-icon-button" type="button" aria-label="Select leaf icon" @click="selectIcon('mdi:leaf')">
          <iconify-icon icon="mdi:leaf" aria-hidden="true"></iconify-icon>
