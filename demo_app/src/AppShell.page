<script>
import { effect, onCleanup, onMount } from 'nodula-framework';
import { createRouter } from 'nodula-framework/router';
import { createSEO } from 'nodula-framework/seo';
import { createNavigation } from 'nodula-framework/navigation';
import { enableLifecycleTransitions } from 'nodula-framework/animation';
import { createLocalStorage } from 'nodula-framework/localstorage';
import { createCookieConsent, setupGoogleAnalytics } from 'nodula-framework/cookieconsent';
import cookieConsentImage from './assets/images/cookie.webp';
import { demoAuth, initializeDemoAuth, navigateDemoRoute, protectDemoAdminRoute, setDemoRouter, signOutDemoAdmin } from './demo-auth.js';
import { notFound, routes } from './routes.js';

const GA_ID = 'G-7TZGDGCGKJ';
// For router
//import { createRouter } from 'nodula-framework/router';
//import { notFound, routes } from './routes.js';

// Router based on routes.js
// const router = createRouter(routes, notFound, {
//   mode: 'history',
//   beforeEach: protectDemoAdminRoute,
// });

// Filerouter based on pages in /routes
const router = createRouter(routes, notFound, {
  mode: 'history',
  beforeEach: protectDemoAdminRoute,
});

const seo = createSEO(router, {
  siteUrl: 'https://nodula.richardleurs.nl',
  defaults: {
    title: 'Nodula | A small framework for big ideas',
    description: 'Nodula is a lightweight JavaScript framework built around modular architecture, simplicity and speed.',
    keywords: 'framework, javascript, lightweight, modular, fast, small, modern, web application',
    author:'Richard Leurs',
    robots: 'index, follow',
    openGraph: {
      siteName: 'Nodula',
      type: 'website',
      image: 'https://nodula.richardleurs.nl/assets/bg-nodula.webp',
    },
  },
});

setDemoRouter(router);
enableLifecycleTransitions({ options: { duration: 500, easing: 'ease-out' } });

let consent;
let siteHeaderElement;

function setSiteHeaderElement(element) {
  siteHeaderElement = element;
}

function updateSiteHeaderScrollState() {
  siteHeaderElement?.classList.toggle('ui-site-header--scrolled', window.scrollY > 0);
}

onCleanup(() => consent?.close());
onCleanup(() => window.removeEventListener('scroll', updateSiteHeaderScrollState));

onMount(() => {
  updateSiteHeaderScrollState();
  window.addEventListener('scroll', updateSiteHeaderScrollState, { passive: true });

  consent = createCookieConsent({
  siteName: 'Nodula',
  image: cookieConsentImage,
  //description: 'We use necessary storage to keep the demo working. \nOptional analytics remains disabled unless you choose it. \nYou can change or withdraw your choice at any time using Cookie settings.',
  labels: {
    title: 'Your privacy choices',
    bannerDescription: 'We use necessary local storage to keep the demo working.\nOptional analytics remains disabled unless you choose it.\nYou can change or withdraw your choice at any time using Cookie settings.',
    preferences: 'Choose your cookie preferences',
    necessary: 'Necessary',
    necessaryDescription: 'Required to run this demo. Always active.',
    analytics: 'Analytics',
    analyticsDescription: 'Helps us understand which Nodula pages visitors use. Shares data with Google Analytics.',
    personalization: 'Personalisation',
    personalizationDescription: 'Remembers preferences that make the Nodula demo more useful.',
    marketing: 'Marketing',
    marketingDescription: 'Measures the effectiveness of Nodula announcements and campaigns.',
    btn_acceptAll: 'Accept all',
    btn_reject: 'Reject non-essential',
    btn_manage: 'Manage preferences',
    btn_save: 'Save preferences',
    btn_cancel: 'Cancel',
    btn_settings: 'Cookie settings',
    privacyPolicy: 'Privacy policy',
  },
//   categories: [
//   {
//     id: 'another',
//     label: 'this is an extra category',
//     description: 'explain what it is',
//   },
// ],
  showAnalytics: true,
  showPersonalization: false,
  showMarketing: false,
  privacyPolicyUrl: 'https://nodula-docs.richardleurs.nl/guide/privacy.html',
  showSettingsButton: false
  });

  setupGoogleAnalytics(consent, GA_ID);
});

let disposeNavigation;
let disposeNavigationEffect;
let navigationElement;
let authButtonElement;
let disposeAuthButtonEffect;

function setAuthButtonElement(element) {
  disposeAuthButtonEffect?.();
  authButtonElement = element;
  if (!element) return;

  const svgNamespace = 'http://www.w3.org/2000/svg';
  const signOutIcon = document.createElementNS(svgNamespace, 'svg');
  signOutIcon.setAttribute('xmlns', svgNamespace);
  signOutIcon.setAttribute('width', '16');
  signOutIcon.setAttribute('height', '16');
  signOutIcon.setAttribute('fill', 'currentColor');
  signOutIcon.setAttribute('class', 'bi bi-person-fill');
  signOutIcon.setAttribute('viewBox', '0 0 16 16');
  signOutIcon.setAttribute('aria-hidden', 'true');
  const signOutPath = document.createElementNS(svgNamespace, 'path');
  signOutPath.setAttribute('d', 'M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6');
  signOutIcon.append(signOutPath);

  const signInIcon = document.createElementNS(svgNamespace, 'svg');
  signInIcon.setAttribute('xmlns', svgNamespace);
  signInIcon.setAttribute('width', '16');
  signInIcon.setAttribute('height', '16');
  signInIcon.setAttribute('fill', 'currentColor');
  signInIcon.setAttribute('class', 'bi bi-person-fill-lock');
  signInIcon.setAttribute('viewBox', '0 0 16 16');
  signInIcon.setAttribute('aria-hidden', 'true');
  const signInPath = document.createElementNS(svgNamespace, 'path');
  signInPath.setAttribute('d', 'M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0m-9 8c0 1 1 1 1 1h5v-1a2 2 0 0 1 .01-.2 4.49 4.49 0 0 1 1.534-3.693Q8.844 9.002 8 9c-5 0-6 3-6 4m7 0a1 1 0 0 1 1-1v-1a2 2 0 1 1 4 0v1a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1zm3-3a1 1 0 0 0-1 1v1h2v-1a1 1 0 0 0-1-1');
  signInIcon.append(signInPath);

  disposeAuthButtonEffect = effect(() => {
    const status = demoAuth.status();
    const signedIn = status === 'authenticated';
    const busy = status === 'idle' || status === 'loading';
    const tooltipText = element.closest('.ui-tooltip')?.querySelector('.ui-tooltip-text');
    element.replaceChildren(signedIn ? signOutIcon.cloneNode(true) : signInIcon.cloneNode(true));
    element.disabled = busy;
    element.setAttribute('aria-label', busy ? 'Checking demo authentication status' : signedIn ? 'Sign out of the demo administrator account' : 'Sign in as the demo administrator');
    element.setAttribute('aria-busy', busy ? 'true' : 'false');
    if (tooltipText) tooltipText.textContent = busy ? 'Checking sign-in status…' : signedIn ? 'Sign out' : 'Sign in';
  });
}

async function toggleDemoSignIn() {
  try {
    await initializeDemoAuth();
    if (demoAuth.isAuthenticated()) {
      await signOutDemoAdmin();
      router.navigate('/');
      return;
    }

    router.navigate('/login');
  } catch (error) {
    console.error('Demo authentication action failed:', error);
  }
}

function setNavigationElement(element) {
  disposeNavigationEffect?.();
  disposeNavigation?.();
  navigationElement = element;
  if (!element) return;

  disposeNavigationEffect = effect(() => {
    const isAdmin = demoAuth.status() === 'authenticated' && demoAuth.user()?.role === 'admin';
    const items = [
      { label: 'Home', href: '/' },

      { label: 'Add-ons', href: '/addons' },
      { label: 'Data', href: '/data' },
      { label: 'Forms', href: '/forms' },
        { label: 'Dialogs', href: '/modal' },
      { label: 'Web Components', href: '/web-components' },
      // { label: 'NodulaUI', href: '/democss' },
      //...(isAdmin ? [{ label: 'Admin', href: '/admin' }] : []),
      // { label: 'Demo login', href: '/login' },
      { label: 'Guide', href: 'https://nodula-docs.richardleurs.nl/', external: true },
    ];

    disposeNavigation?.();
    disposeNavigation = createNavigation(element, router, items, {
      label: 'Main navigation',
      linkClassName: 'ui-nav-link',
      activeClassName: 'ui-nav-link--active',
    });
  });
}
onCleanup(() => {
  disposeNavigation?.();
  disposeNavigationEffect?.();
  disposeAuthButtonEffect?.();
  seo.dispose();
});
const [theme, setTheme] = createLocalStorage('nodula-theme', 'dark');

effect(() => {
  document.documentElement.dataset.theme = theme();
  document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme() === 'light' ? '#f5f8f1' : '#101b25');
});

function toggleTheme() {
  const next = theme() === 'dark' ? 'light' : 'dark';
  setTheme(next);
}

function setCookieSettingsIcon(element) {
  if (!element) return;

  const svgNamespace = 'http://www.w3.org/2000/svg';
  const gear = document.createElementNS(svgNamespace, 'svg');
  gear.setAttribute('xmlns', svgNamespace);
  gear.setAttribute('width', '16');
  gear.setAttribute('height', '16');
  gear.setAttribute('fill', 'currentColor');
  gear.setAttribute('class', 'bi bi-gear-fill');
  gear.setAttribute('viewBox', '0 0 16 16');
  gear.setAttribute('aria-hidden', 'true');
  const path = document.createElementNS(svgNamespace, 'path');
  path.setAttribute('d', 'M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z');
  gear.append(path);
  element.replaceChildren(gear);
}

function openCookieSettings() {
  consent?.openSettings();
}

function setThemeToggleIcons(element) {
  if (!element) return;

  const svgNamespace = 'http://www.w3.org/2000/svg';
  const sun = document.createElementNS(svgNamespace, 'svg');
  sun.setAttribute('width', '16');
  sun.setAttribute('height', '16');
  sun.setAttribute('fill', 'currentColor');
  sun.setAttribute('class', 'bi bi-sun-fill ui-theme-toggle__sun');
  sun.setAttribute('viewBox', '0 0 16 16');
  sun.setAttribute('aria-hidden', 'true');
  const sunPath = document.createElementNS(svgNamespace, 'path');
  sunPath.setAttribute('d', 'M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708');
  sun.append(sunPath);

  const moon = document.createElementNS(svgNamespace, 'svg');
  moon.setAttribute('width', '16');
  moon.setAttribute('height', '16');
  moon.setAttribute('fill', 'currentColor');
  moon.setAttribute('class', 'bi bi-moon-fill ui-theme-toggle__moon');
  moon.setAttribute('viewBox', '0 0 16 16');
  moon.setAttribute('aria-hidden', 'true');
  const moonPath = document.createElementNS(svgNamespace, 'path');
  moonPath.setAttribute('d', 'M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278');
  moon.append(moonPath);

  element.replaceChildren(sun, moon);
}
</script>

<template>
  <div class="ui-app">

    <header class="ui-site-header" @ref="setSiteHeaderElement">
      <a class="ui-brand" href="/" aria-label="Nodula home">
        <!-- <span class="ui-brand__mark" aria-hidden="true">s</span> -->
        <span class="ui-brand__logo" aria-hidden="true"></span>
        <span class="ui-brand__name"><b>nodula</b></span>
        <span class="ui-brand__version">0.1</span>
      </a>
      <nav class="ui-site-nav" @ref="setNavigationElement"></nav>
      <div class="ui-header-actions">
        <div class="ui-tooltip"><span class="ui-tooltip-text">Sign-in</span>
        <button class="ui-auth-toggle" type="button" @click="toggleDemoSignIn()" @ref="setAuthButtonElement" aria-label="Checking demo authentication status" aria-busy="true"> </button>
     </div>
        <div class="ui-tooltip"><span class="ui-tooltip-text">Cookie settings</span>
          <button class="ui-cookie-settings-toggle" type="button" @click="consent.openSettings()" @ref="setCookieSettingsIcon" aria-label="Open cookie settings"></button>
        </div>
  <div class="ui-tooltip"><span class="ui-tooltip-text">{{ theme() === 'dark' ? 'Light mode' : 'Dark mode' }}</span>
     <button class="ui-theme-toggle" type="button" @click="toggleTheme()" @ref="setThemeToggleIcons" :aria-label="theme() === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'" :aria-pressed="theme() === 'light' ? 'true' : 'false'"></button>
</div>
</div>
    <!-- <a class="ui-github-link" href="https://vite.dev/" target="_blank" rel="noreferrer">Made for the web <span aria-hidden="true"> ↗</span></a> -->
    </header>
    <div class="route-view">
      <outlet :view="router.view()" />
    </div>
    <footer class="ui-site-footer">
      <span>A small framework for big ideas </span>
       <span>This site is build with Nodula</span>
      <span>Copyright © Richard Leurs 2026 | GNU General Public License v3 </span>
    </footer>
  </div>
</template>