<script>
import { onCleanup, signal } from "nodula-framework";
import { DataError } from "nodula-framework/data";
import { createSupabaseAdapter } from "nodula-framework/data-supabase";

const notConfiguredMessage = "Supabase is not configured for this build.";
const supabaseUrl = (props["api-base"] ?? "").replace(/\/+$/, "");
const apiKey = props["api-key"] ?? "";
const configured = Boolean(supabaseUrl && apiKey);
const storeName = props["store-name"] ?? "Supabase ideas";
// The adapter sends the API key as `apikey` and as a bearer token on every request.
const api = configured
  ? createSupabaseAdapter({ baseURL: supabaseUrl, apiKey, table: props.table ?? "ideas" })
  : undefined;
const [ideas, setIdeas] = signal([]);
const [draft, setDraft] = signal("");
const [loading, setLoading] = signal(configured);
const [busy, setBusy] = signal(false);
const [status, setStatus] = signal(
  configured ? `Loading ideas from ${storeName}…` : notConfiguredMessage,
);
// Ideas per page; small so the pager shows up with the demo's few rows.
const perPage = 5;
const [page, setPage] = signal(1);
const [totalPages, setTotalPages] = signal(1);
const [totalItems, setTotalItems] = signal(0);
let activeRequest;

/**
 * A short message for a failed request: the PostgREST message when it sent one, otherwise the error message.
 *
 * @param {unknown} error
 * @returns {string}
 */
function describeError(error) {
  if (error instanceof DataError) {
    const detail = error.data?.message ?? error.message;
    return `API returned HTTP ${error.status}: ${detail}`;
  }
  return error?.message || "Could not connect to Supabase.";
}

/**
 * Load the current page of ideas from Supabase. A newer load cancels an older one. Does nothing when Supabase is not configured.
 *
 * @returns {Promise<void>}
 */
async function loadIdeas() {
  if (!configured) return;
  activeRequest?.abort();
  const controller = new AbortController();
  activeRequest = controller;
  setLoading(true);
  try {
    const result = await api.listPage({
      page: page(),
      perPage,
      params: { order: "id.asc" },
      signal: controller.signal,
    });
    const items = result.items;
    if (!Array.isArray(items)) throw new Error("Supabase returned an invalid ideas list.");
    // Rows are keyed by their slot on the page, not by record id, so changing page updates the rows in
    // place. Keyed by id, every old row would play its leave animation while the new ones fade in.
    setIdeas(items.map((idea, slot) => ({ ...idea, slot })));
    setTotalPages(result.totalPages);
    setTotalItems(result.totalItems);
    props.onData?.(JSON.stringify(items));
    setStatus(`Connected to ${storeName}. ${totalItems()} in total.`);
  } catch (error) {
    if (error?.name !== "AbortError") setStatus(describeError(error));
  } finally {
    if (activeRequest === controller) {
      activeRequest = undefined;
      setLoading(false);
    }
  }
}

/**
 * Create an idea from the draft in Supabase, then reload the list.
 *
 * @param {SubmitEvent} event
 * @returns {Promise<void>}
 */
async function addIdea(event) {
  event.preventDefault();
  const text = draft().trim();
  if (!text || busy() || !configured) return;
  setBusy(true);
  try {
    await api.create({ text });
    setDraft("");
    await loadIdeas();
  } catch (error) {
    setStatus(describeError(error));
  } finally {
    setBusy(false);
  }
}

/**
 * Set an idea done or not done in Supabase, then reload the list.
 *
 * @param {number} id
 * @param {boolean} done
 * @returns {Promise<void>}
 */
async function toggleIdea(id, done) {
  if (busy()) return;
  setBusy(true);
  try {
    await api.update(id, { done });
    await loadIdeas();
  } catch (error) {
    setStatus(describeError(error));
  } finally {
    setBusy(false);
  }
}

/**
 * Delete an idea in Supabase, then reload the list.
 *
 * @param {number} id
 * @returns {Promise<void>}
 */
async function removeIdea(id) {
  if (busy()) return;
  setBusy(true);
  try {
    await api.delete(id);
    // Removing the last idea of the last page would leave an empty page, so step back one page.
    if (ideas().length === 1 && page() > 1) setPage(page() - 1);
    await loadIdeas();
  } catch (error) {
    setStatus(describeError(error));
  } finally {
    setBusy(false);
  }
}

/**
 * Show another page of ideas and load it.
 *
 * @param {number} next 1-based page number.
 * @returns {void}
 */
function goToPage(next) {
  setPage(next);
  void loadIdeas();
}

void loadIdeas();
onCleanup(() => activeRequest?.abort());
</script>

<template>
  <article class="ui-panel ui-panel--raised ui-ideas-card ui-supabase-ideas-card">
    <div class="ui-ideas-card__heading">
      <h3 class="ui-card__title">{{ storeName }}</h3>
      <span class="ui-badge ui-badge--success"
        >{{ ideas().filter((idea) => idea.done).length }} / {{ ideas().length }} done</span
      >
    </div>
    <p class="ui-ideas-card__status" role="status" aria-live="polite">{{ status() }}</p>
    <ul class="ui-ideas-list">
      <li
        class="ui-ideas-list__item"
        @for="idea of ideas()"
        :key="idea.slot"
        :class="
          idea().done ? 'ui-ideas-list__item ui-ideas-list__item--done' : 'ui-ideas-list__item'
        "
      >
        <label class="ui-checkbox ui-ideas-list__label">
          <input
            class="ui-checkbox__control"
            type="checkbox"
            :checked="idea().done"
            :disabled="busy()"
            @change="toggleIdea(idea().id, $event.currentTarget.checked)"
          />
          <span>{{ idea().text }}</span>
        </label>
        <button
          class="ui-ideas-list__remove"
          type="button"
          :aria-label="'Remove ' + idea().text"
          :disabled="busy()"
          @click="removeIdea(idea().id)"
        >
          ×
        </button>
      </li>
    </ul>
    <div class="ui-cluster ui-ideas-card__pager" @if="totalPages() > 1">
      <button
        class="ui-button ui-button--secondary ui-button--small"
        type="button"
        aria-label="Previous page"
        :disabled="loading() || busy() || page() <= 1"
        @click="goToPage(page() - 1)"
      >
        Previous
      </button>
      <span class="ui-ideas-card__page">Page {{ page() }} of {{ totalPages() }}</span>
      <button
        class="ui-button ui-button--secondary ui-button--small"
        type="button"
        aria-label="Next page"
        :disabled="loading() || busy() || page() >= totalPages()"
        @click="goToPage(page() + 1)"
      >
        Next
      </button>
    </div>
    <form class="ui-cluster ui-ideas-card__add" @submit="addIdea($event)">
      <input
        class="ui-input"
        type="text"
        maxlength="200"
        placeholder="Add a Supabase idea…"
        :value="draft()"
        @input="setDraft($event.currentTarget.value)"
        aria-label="New Supabase idea"
        :disabled="loading() || busy() || !configured"
      />
      <button
        class="ui-button ui-button--primary ui-ideas-card__add-button"
        type="submit"
        aria-label="Add Supabase idea"
        :disabled="loading() || busy() || !configured"
      >
        +
      </button>
    </form>
  </article>
</template>

