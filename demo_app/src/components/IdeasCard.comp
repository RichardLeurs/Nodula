<script>
import { signal } from 'nodula-framework';
import { createIndexedDB } from 'nodula-framework/localstorage';

const initialIdeas = [
  { id: 1, text: 'Sketch out a weekend garden', done: false },
  { id: 2, text: 'Make a tiny thing that feels good', done: true },
  { id: 3, text: 'Share an idea with a friend', done: false },
];

const storedIdeas = createIndexedDB('nodula-ideas', initialIdeas);
const [ideas, setIdeas] = storedIdeas;
const [draft, setDraft] = signal('');
const [ready, setReady] = signal(false);
const [status, setStatus] = signal('Loading saved ideas…');
/**
 * The number of ideas marked done.
 */
const doneCount = () => ideas().filter((idea) => idea.done).length;

void storedIdeas.ready.then(() => {
  setReady(true);
  setStatus(storedIdeas.available ? 'IndexedDB available.' : 'IndexedDB not available.');
});

/**
 * Mark one idea done or not done.
 *
 * @param {number} id
 * @param {boolean} checked
 */
function toggleIdea(id, checked) {
  setIdeas((current) => current.map((idea) => idea.id === id ? { ...idea, done: checked } : idea));
}

/**
 * Remove one idea.
 *
 * @param {number} id
 */
function removeIdea(id) {
  setIdeas((current) => current.filter((idea) => idea.id !== id));
}

/**
 * Add the draft as a new idea. Ignored while the saved ideas are still loading or the draft is empty.
 *
 * @param {SubmitEvent} event
 */
function addIdea(event) {
  event.preventDefault();
  const text = draft().trim();
  if (!text || !ready()) return;

  const id = ideas().reduce((largest, idea) => Math.max(largest, Number(idea.id) || 0), 0) + 1;
  setIdeas((current) => [...current, { id, text, done: false }]);
  setDraft('');
}
</script>

<template>
  <article class="ui-panel ui-panel--raised ui-ideas-card">
    <div class="ui-cluster"></div>
    <div class="ui-ideas-card__heading">
      <h3 class="ui-card__title">Things worth doing</h3>
      <span class="ui-badge ui-badge--success">{{ doneCount() }} / {{ ideas().length }} done</span>
    </div>
    <p class="ui-ideas-card__status" role="status">{{ status() }}</p>
    </BR>
    <ul class="ui-ideas-list">
      <li class="ui-ideas-list__item" @for="idea of ideas()" :key="idea.id" :class="idea().done ? 'ui-ideas-list__item ui-ideas-list__item--done' : 'ui-ideas-list__item'">
        <label class="ui-checkbox ui-ideas-list__label">
          <input class="ui-checkbox__control" type="checkbox" :checked="idea().done" @change="toggleIdea(idea().id, $event.currentTarget.checked)" />
          <span>{{ idea().text }}</span>
        </label>
        <button class="ui-ideas-list__remove" type="button" :aria-label="'Remove ' + idea().text" @click="removeIdea(idea().id)">×</button>
      </li>
    </ul>
    <form class="ui-cluster ui-ideas-card__add" @submit="addIdea($event)">
      <input class="ui-input" type="text" placeholder="Add a small idea…" @bind:value="draft, setDraft" aria-label="New idea" :disabled="!ready()" />
      <button class="ui-button ui-button--primary ui-ideas-card__add-button" type="submit" aria-label="Add idea" :disabled="!ready()">+</button>
    </form>
  </article>
</template>

