<script>
import { effect, signal } from "nodula-framework";
import { createForm } from "nodula-framework/form";
import { animate } from "nodula-framework/animation";
import { showDialog } from "nodula-framework/dialog";
import { showNotification } from "nodula-framework/notification";
import formImage from "../assets/images/form.webp";
import styles from "../assets/css/form.module.css";
const [submissionMessage, setSubmissionMessage] = signal("");
let successMessageElement = null;

/**
 * Remember the element that shows the success message, so it can be animated.
 *
 * @param {HTMLElement | null} element
 */
function setSuccessMessageElement(element) {
  successMessageElement = element;
}

effect(() => {
  if (submissionMessage() && successMessageElement) {
    animate(
      successMessageElement,
      [
        { opacity: 0, transform: "translateY(6px)" },
        { opacity: 1, transform: "translateY(0)" },
      ],
      { duration: 220, easing: "ease-out", fill: "both" },
    );
  }
});

const form = createForm(
  { name: "", email: "", updates: false },
  {
    // Element IDs become form-name, form-email and their error elements.
    idPrefix: "form",
    // The success message is shown with textContent, so the raw name is safe to display.
    escapeHtml: false,
    validate: (values) => ({
      ...(!values.name.trim() ? { name: "Enter your name." } : {}),
      ...(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(values.email)
        ? { email: "Enter a valid email address." }
        : {}),
    }),
    onSubmit: async (values) => {
      await Promise.resolve();
      const name = values.name.trim();
      setSubmissionMessage(`Thanks, ${name}! Your form was submitted.`);
      showNotification({
        type: "success",
        title: "Form submitted",
        message: `Thanks, ${name}! Your form was submitted successfully.`,
      });
    },
  },
);

// Field helpers: stable IDs, the visible error, and ARIA attributes for each control.
const nameField = form.field("name");
const emailField = form.field("email");
// The error element is always rendered, so the control may reference it; no description element exists.
/**
 * The `aria-describedby` value for a field, or null when it has none.
 *
 * @param {object} field A field from `form.field()`.
 * @returns {string | null}
 */
const describedBy = (field) => field.attributes()["aria-describedby"] ?? null;

/**
 * Ask for confirmation, then reset the form and clear the success message.
 *
 * @returns {Promise<void>}
 */
async function resetForm() {
  const confirmed = await showDialog("Reset this form? Your changes will be cleared.", {
    title: "Reset form?",
    btn_cancel: "Keep editing",
    btn_ok: "Reset form",
  });
  if (!confirmed) return;

  form.reset();
  setSubmissionMessage("");
}
</script>

<template>
  <main class="ui-page page">
    <header class="ui-page__header">
      <p class="ui-page__eyebrow">Optional form add-on</p>

      <div class="ui-page__title-row">
        <h1 class="ui-page__title">A form, with the state included.</h1>
        <img
          class="ui-page__header-image"
          :src="formImage"
          alt=""
          width="128"
          height="147"
          aria-hidden="true"
        />
      </div>

      <p class="ui-page__description">
        This example uses Nodula's <code>createForm</code> for values, validation, touched fields,
        submission state, and reset—without adding a form library.
      </p>
    </header>

    <section class="ui-section" aria-labelledby="form-example-title">
      <form class="ui-panel ui-panel--raised" @submit="form.handleSubmit($event)" novalidate>
        <header class="ui-panel__header">
          <div>
            <h2 id="form-example-title" class="ui-panel__title">Contact details</h2>
            <p class="ui-panel__description">
              Fields marked required must be completed before submission.
            </p>
          </div>
        </header>
        <div class="ui-form__body">
          <div class="ui-field" :class="nameField.invalid() ? 'ui-field--invalid' : ''">
            <label class="ui-field__label" :for="nameField.ids.control"
              >Name <span class="ui-field__required" aria-label="required">*</span></label
            >
            <input
              class="ui-input"
              :id="nameField.ids.control"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="Jane Smith"
              :value="nameField.value()"
              @input="form.handleChange('name')($event)"
              @blur="form.handleBlur('name')()"
              :aria-invalid="nameField.invalid() ? 'true' : 'false'"
              :aria-describedby="describedBy(nameField)"
            />
            <p
              :id="nameField.ids.error"
              class="ui-field__error"
              role="alert"
              @show="nameField.invalid()"
            >
              {{ nameField.visibleError() ?? "" }}
            </p>
          </div>

          <div class="ui-field" :class="emailField.invalid() ? 'ui-field--invalid' : ''">
            <label class="ui-field__label" :for="emailField.ids.control"
              >Email <span class="ui-field__required" aria-label="required">*</span></label
            >
            <input
              class="ui-input"
              :id="emailField.ids.control"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="jane@example.com"
              :value="emailField.value()"
              @input="form.handleChange('email')($event)"
              @blur="form.handleBlur('email')()"
              :aria-invalid="emailField.invalid() ? 'true' : 'false'"
              :aria-describedby="describedBy(emailField)"
            />
            <p
              :id="emailField.ids.error"
              class="ui-field__error"
              role="alert"
              @show="emailField.invalid()"
            >
              {{ emailField.visibleError() ?? "" }}
            </p>
          </div>

          <label class="ui-checkbox">
            <input
              class="ui-checkbox__control"
              name="updates"
              type="checkbox"
              :checked="form.values.updates"
              @change="form.handleChange('updates')($event)"
            />
            <span>Send me occasional Nodula updates</span>
          </label>

          <div class="ui-cluster ui-cluster--wrap">
            <button
              class="ui-button ui-button--primary"
              type="submit"
              :disabled="form.submitting()"
            >
              {{ form.submitting() ? "Submitting…" : "Submit example" }}
            </button>
            <button class="ui-button ui-button--secondary" type="button" @click="resetForm()">
              Reset
            </button>
            <span class="ui-form__dirty" role="status">{{
              form.dirty() ? "Unsaved changes" : "No changes yet"
            }}</span>
          </div>

          <div
            class="ui-alert ui-alert--success ui-form__success"
            role="status"
            @ref="setSuccessMessageElement"
            @show="Boolean(submissionMessage())"
          >
            <span class="ui-alert__icon" aria-hidden="true">✓</span>
            <p class="ui-alert__text">{{ submissionMessage() }}</p>
          </div>
        </div>
      </form>
    </section>

    <section class="ui-section" aria-labelledby="form-code-title">
      <h2 id="form-code-title" :class="`${styles.setupTitle} ui-section__title`">Form setup</h2>
      <p class="ui-section__description">
        Create a form with initial values, validation, and an async submit handler.
      </p>
      <pre class="ui-code-block"><code data-highlight>const form = createForm(initialValues, {
  idPrefix: "form",
  validate: (values) =&gt; errors,
  onSubmit: async (values) =&gt; save(values),
});
const email = form.field("email");
// email.ids.control, email.ids.error; email.visibleError(); email.attributes()</code></pre>
    </section>
    <!-- <a class="button button--dark" href="/guide">Back to the guide</a> -->
  </main>
</template>
