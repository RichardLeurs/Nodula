<script>
import { signal } from "nodula-framework";
import { showDialog } from "nodula-framework/dialog";
import { showModal } from "nodula-framework/modal";
import { showDrawer } from "nodula-framework/drawer";
import addonImage from "../assets/images/addon.webp";
import modalImage from "../assets/images/modal.webp";
import drawerImage from "../assets/images/drawer.webp";
import dialogImage from "../assets/images/dialog.webp";

const [count, setCount] = signal(0);

/**
 * Show the confirmation dialog and wait for the answer.
 *
 * @returns {Promise<void>}
 */
async function showExampleDialog() {
  await showDialog("Continue with this action?", {
    title: "Confirmation dialog",
    btn_cancel: "Keep editing",
    btn_ok: "Continue",
  });
}

/**
 * Open the example modal with the content from this page.
 */
function showExampleModal() {
  showModal("#modal-content", {
    title: "A modal window",
    showHeader: false,
    closeOnBackdrop: false,
  });
}

/**
 * Open the example side drawer with the content from this page.
 */
function showExampleDrawer() {
  showDrawer("#drawer-content", {
    title: "A side drawer",
    showHeader: false,
    closeOnBackdrop: false,
    position: "left",
  });
}
</script>

