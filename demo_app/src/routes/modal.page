<script>
import { signal } from 'nodula-framework';
import { showDialog } from 'nodula-framework/dialog';
import { showModal } from 'nodula-framework/modal';
import { showDrawer } from 'nodula-framework/drawer';
import addonImage from '../assets/images/addon.webp';
import modalImage from '../assets/images/modal.webp';
import drawerImage from '../assets/images/drawer.webp';
import dialogImage from '../assets/images/dialog.webp';

const [count, setCount] = signal(0);

async function showExampleDialog() {
  await showDialog('Continue with this action?', {
    title: 'Confirmation dialog',
    btn_cancel: 'Keep editing',
    btn_ok: 'Continue',
  });
}

function showExampleModal() {
  const content = document.createElement('p');
  content.textContent = 'This modal is provided by the optional Nodula modal add-on.';
  showModal(content, { title: 'A modal window', btn_close: 'Got it', closeOnBackdrop: false });
}

function showExampleDrawer() {
  const content = document.createElement('p');
  content.textContent = 'This side panel is a modal drawer. Click outside to dismiss it, or use the close button.';
  showDrawer(content, { title: 'A side drawer', btn_close: 'Close panel', closeOnBackdrop: false, position: 'left' });
}
</script>

<template>
  <main class="ui-page page">
    <header class="ui-page__header ui-page__header--with-image">
      <p class="ui-page__eyebrow">Optional overlay add-ons</p>
      <div class="ui-page__title-row">
        <h1 class="ui-page__title">Dialogs, modals, and drawers.</h1>
        <!-- <img class="ui-page__header-image" :src="addonImage" alt="" width="128" height="147" aria-hidden="true"> -->
        <img class="ui-page__header-image" :src="dialogImage" alt="" width="128" height="145" aria-hidden="true">
        <img class="ui-page__header-image" :src="modalImage" alt="" width="128" height="145" aria-hidden="true">
        <img class="ui-page__header-image" :src="drawerImage" alt="" width="128" height="145" aria-hidden="true">
      </div>
      <p class="ui-page__description">Use a confirmation dialog for a focused yes-or-no choice, a modal for custom content, or a drawer for a side panel.</p>
    </header>

    <!-- <div class="template-demo">
      <p>This button is rendered from an HTML template. Count: <strong>{{ count() }}</strong></p>
      <button class="button button--dark" type="button" @click="setCount(count() + 1)">Add one</button>
    </div> -->

    <section class="ui-section" aria-label="Dialog, modal, and drawer examples">
      <div class="ui-grid ui-grid--2">
        <article class="ui-card">
          <header class="ui-card__header">
            <h2 class="ui-card__title">Confirmation dialog</h2>
          </header>
          <div class="ui-card__body ui-stack ui-stack--tight">
            <p class="ui-card__description">Ask for confirmation with a message and Cancel/OK choices. The result resolves to true or false.</p>
            <pre class="ui-code-block"><code data-highlight>await showDialog('Continue with this action?', { title: 'Confirmation dialog' });</code></pre>
          </div>
          <footer class="ui-card__footer">
            <button class="ui-button ui-button--primary" type="button" @click="showExampleDialog()">Open example dialog</button>
          </footer>
        </article>

        <article class="ui-card">
          <header class="ui-card__header">
       
            <h2 class="ui-card__title">Modal window</h2>
             
          
            <!-- <span class="ui-badge ui-badge--primary">Modal</span> -->
          </header>
          <div class="ui-card__body ui-stack ui-stack--tight">
            <p class="ui-card__description">The optional modal add-on can display interactive DOM content in a centered dialog.</p>
            <pre class="ui-code-block"><code data-highlight>showModal(content, { title: 'A modal window', closeOnBackdrop: false });</code></pre>
          </div>
          <footer class="ui-card__footer">
            <button class="ui-button ui-button--primary" type="button" @click="showExampleModal()">Open example modal</button>
          </footer>
        </article>

        <article class="ui-card">
          <header class="ui-card__header">
            <h2 class="ui-card__title">Side drawer</h2>
            <!-- <span class="ui-badge ui-badge--info">Drawer</span> -->
          </header>
          <div class="ui-card__body ui-stack ui-stack--tight">
            <p class="ui-card__description">Open a side panel with configurable placement and backdrop dismissal.</p>
            <pre class="ui-code-block"><code data-highlight>showDrawer(content, { title: 'A side drawer', position: 'left' });</code></pre>
          </div>
          <footer class="ui-card__footer">
            <button class="ui-button ui-button--primary" type="button" @click="showExampleDrawer()">Open example side drawer</button>
          </footer>
        </article>
      </div>
    </section>

    <!-- <a class="button button--primary" href="/">Back to the playground <span aria-hidden="true"> ↗</span></a> -->
    <div class="ui-section">
      <a class="ui-button ui-button--outline" href="/ideas/1">Try a nested idea route <span aria-hidden="true">↗</span></a>
    </div>
  </main>
</template>
