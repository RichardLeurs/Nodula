<script setup>
import { onCleanup, signal } from 'nodula-framework';
import { createDataClient, DataError } from 'nodula-framework/data';
import dataImage from '../assets/images/data.webp';

const sampleUrl = 'https://jsonplaceholder.typicode.com/posts/1';
const dataClient = createDataClient();
const [endpoint, setEndpoint] = signal(sampleUrl);
const [record, setRecord] = signal(null);
const [loading, setLoading] = signal(false);
const [errorMessage, setErrorMessage] = signal('');
let activeRequest;

async function loadJson(event) {
  event?.preventDefault?.();
  activeRequest?.abort();
  const controller = new AbortController();
  activeRequest = controller;
  setLoading(true);
  setRecord(null);
  setErrorMessage('');

  try {
    const result = await dataClient.get(endpoint().trim(), { signal: controller.signal });
    setRecord(result);
  } catch (error) {
    if (error?.name === 'AbortError') return;
    setErrorMessage(error instanceof DataError
      ? `The server returned HTTP ${error.status}: ${error.message}`
      : error?.message || 'Could not load JSON from that address.');
  } finally {
    if (activeRequest === controller) {
      activeRequest = undefined;
      setLoading(false);
    }
  }
}

onCleanup(() => activeRequest?.abort());
</script>

<template>
  <main class="ui-page page">
    <header class="ui-page__header ui-page__header--with-image">
      <p class="ui-page__eyebrow">Optional data add-on</p>
      <div class="ui-page__title-row">
        <h1 class="ui-page__title">Load data from a server.</h1>
        <img class="ui-page__header-image" :src="dataImage" alt="" width="128" height="147" aria-hidden="true">
      </div>
      <p class="ui-page__description">This page uses <code>nodula-framework/data</code> to request a JSON resource with Fetch, then renders the response and handles loading or HTTP errors.</p>
    </header>

    <section class="ui-section" aria-labelledby="data-request-title">
      <form class="ui-panel ui-panel--raised ui-data-form" @submit="loadJson($event)">
        <header class="ui-panel__header">
          <div>
            <h2 id="data-request-title" class="ui-panel__title">Request a JSON resource</h2>
            <p class="ui-panel__description">Enter a public endpoint that allows cross-origin requests.</p>
          </div>
        </header>
        <div class="ui-form__body">
          <div class="ui-field">
            <label class="ui-field__label" for="data-endpoint">JSON server address</label>
            <input id="data-endpoint" class="ui-input" type="url" autocomplete="url" placeholder="https://api.example.com/data" required :value="endpoint()" @input="setEndpoint($event.currentTarget.value)" />
            <p class="ui-field__description">Example server: JSONPlaceholder. Change the address to load another CORS-enabled JSON endpoint.</p>
          </div>
        </div>
        <footer class="ui-panel__footer ui-cluster ui-cluster--end">
          <button class="ui-button ui-button--primary" type="submit" :disabled="loading()">{{ loading() ? 'Loading…' : 'Load JSON' }}</button>
        </footer>
      </form>

      <div class="ui-alert ui-alert--info ui-data-status" role="status" aria-live="polite" @show="loading()">
        <span class="ui-alert__icon" aria-hidden="true">i</span>
        <p class="ui-alert__text">Loading JSON…</p>
      </div>

      <div class="ui-alert ui-alert--danger ui-data-error" role="alert" @show="Boolean(errorMessage())">
        <span class="ui-alert__icon" aria-hidden="true">!</span>
        <p class="ui-alert__text">{{ errorMessage() }}</p>
      </div>

      <section class="ui-panel ui-panel--bordered ui-data-response" aria-labelledby="data-response-heading" @show="record() !== null">
        <header class="ui-panel__header">
          <h2 id="data-response-heading" class="ui-panel__title">Server response</h2>
          <span class="ui-badge ui-badge--primary">JSON</span>
        </header>
        <div class="ui-panel__body ui-data-response__body">
          <pre class="ui-data-response__code"><code>{{ JSON.stringify(record(), null, 2) }}</code></pre>
        </div>
      </section>
    </section>

    <section class="ui-section" aria-labelledby="data-example-title">
      <h2 id="data-example-title" class="ui-section__title">Use the data client</h2>
      <p class="ui-section__description">The same request can be made directly from your application code.</p>
      <pre class="ui-code-block"><code data-highlight>import { createDataClient } from 'nodula-framework/data';

const api = createDataClient();
const post = await api.get('https://jsonplaceholder.typicode.com/posts/1');</code></pre>
    </section>
  </main>
</template>
