  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
  gap: var(--ui-space-4);
  margin-top: var(--ui-space-4);
}

.ui-filedrop-preview {
  display: grid;
  gap: var(--ui-space-2);
  min-width: 0;
  margin: 0;
}

.ui-filedrop-preview img {
  display: block;
