  aspect-ratio: 4 / 3;
  border: 1px solid var(--ui-color-border);
  border-radius: var(--ui-radius-small);
  object-fit: cover;
  background: var(--ui-color-surface-sunken);
}

.ui-filedrop-preview figcaption {
  overflow-wrap: anywhere;
