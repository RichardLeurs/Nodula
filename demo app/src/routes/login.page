<script setup>
import { signal } from 'nodula-framework';
import { demoAuth, initializeDemoAuth } from '../demo-auth.js';

const [message, setMessage] = signal('');

async function signInAsDemoAdmin() {
  message('');
  try {
    await initializeDemoAuth();
    await demoAuth.signIn({ demoAdmin: true });
    message('Signed in for this demo. Continue to the Admin page.');
  } catch (error) {
    message(error instanceof Error ? error.message : 'Demo sign-in failed.');
  }
}
</script>

<template>
  <main class="page-shell auth-demo-page">
    <p class="eyebrow">Nodula Auth demo</p>
    <h1>Demo sign-in</h1>
    <p class="guide-intro">This button creates an in-memory demo identity so you can try the protected Admin route. It is not real authentication and does not protect server data.</p>
    <div class="form-example">
      <p role="status">{{ message() }}</p>
      <button class="button button--primary" type="button" @click="signInAsDemoAdmin()">Sign in as demo administrator</button>
      <!-- <a class="button button--secondary" href="/admin">Continue to Admin</a> -->
    </div>
  </main>
</template>