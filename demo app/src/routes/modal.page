<script setup>
import { signal } from 'nodula-framework';
import { openModal } from 'nodula-framework/modal';
import { openDrawer } from 'nodula-framework/drawer';

const [count, setCount] = signal(0);

function showExampleModal() {
  const content = document.createElement('p');
  content.textContent = 'This modal is provided by the optional Nodula modal add-on.';
  openModal(content, { title: 'A modal window', closeText: 'Got it', closeOnBackdrop: false });
}

function showExampleDrawer() {
  const content = document.createElement('p');
  content.textContent = 'This side panel is a modal drawer. Click outside to dismiss it, or use the close button.';
  openDrawer(content, { title: 'A side drawer', closeText: 'Close panel', closeOnBackdrop: false, position: 'left' });
}
</script>

<template>
  <main class="page-shell guide-page">
    <p class="eyebrow">The short version</p>
    <h1>A small toolkit,<br />not a big ceremony.</h1>
