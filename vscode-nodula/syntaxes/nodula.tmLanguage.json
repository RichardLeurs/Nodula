{
  "scopeName": "source.nodula",
  "fileTypes": ["page", "comp"],
  "name": "Nodula",
  "patterns": [
    { "include": "#script-block" },
    { "include": "#template-block" },
    { "include": "#style-block" }
  ],
  "repository": {
    "block-open": {
      "patterns": [
        { "match": "(</?)(script|template|style)\\b", "captures": {
          "1": { "name": "punctuation.definition.tag.begin.nodula" },
          "2": { "name": "entity.name.tag.nodula" }
        }},
        { "match": "\\b(setup)\\b", "name": "storage.modifier.nodula" },
        { "match": "/>|>", "name": "punctuation.definition.tag.end.nodula" }
      ]
    },
    "script-block": {
      "begin": "(<)(script)\\b([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.nodula" },
        "2": { "name": "entity.name.tag.nodula" },
        "3": { "name": "meta.tag.attributes.nodula" },
        "4": { "name": "punctuation.definition.tag.end.nodula" }
      },
      "end": "(</)(script)(\\s*>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.nodula" },
        "2": { "name": "entity.name.tag.nodula" },
        "3": { "name": "punctuation.definition.tag.end.nodula" }
      },
      "contentName": "meta.embedded.block.javascript",
      "patterns": [
        { "include": "source.js" }
      ]
    },
    "template-block": {
      "begin": "(<)(template)\\b([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.nodula" },
        "2": { "name": "entity.name.tag.nodula" },
        "3": { "name": "meta.tag.attributes.nodula" },
        "4": { "name": "punctuation.definition.tag.end.nodula" }
      },
      "end": "(</)(template)(\\s*>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.nodula" },
        "2": { "name": "entity.name.tag.nodula" },
        "3": { "name": "punctuation.definition.tag.end.nodula" }
      },
      "contentName": "meta.embedded.block.html",
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#nodula-directives" },
        { "include": "#component-tags" },
        { "include": "#template-block" },
        { "include": "text.html.basic" }
      ]
    },
    "interpolation": {
      "begin": "\\{\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.nodula" } },
      "end": "\\}\\}",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.nodula" } },
      "contentName": "meta.embedded.expression.javascript",
      "patterns": [
        { "include": "source.js" }
      ]
    },
    "nodula-directives": {
      "patterns": [
        {
          "match": "(@[\\w-]+|on:[\\w-]+|:[\\w-]+|each|use:[\\w-]+)(?=\\s*=)",
          "name": "entity.other.attribute-name.directive.nodula"
        },
        {
          "match": "(:key)(?=\\s*=)",
          "name": "entity.other.attribute-name.directive.nodula"
        }
      ]
    },
    "component-tags": {
      "match": "(</?)([Ss]uspense)\\b",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.nodula" },
        "2": { "name": "entity.name.tag.component.nodula" }
      }
    },
    "style-block": {
      "begin": "(<)(style)\\b([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.nodula" },
        "2": { "name": "entity.name.tag.nodula" },
        "3": { "name": "meta.tag.attributes.nodula" },
        "4": { "name": "punctuation.definition.tag.end.nodula" }
      },
      "end": "(</)(style)(\\s*>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.nodula" },
        "2": { "name": "entity.name.tag.nodula" },
        "3": { "name": "punctuation.definition.tag.end.nodula" }
      },
      "contentName": "meta.embedded.block.css",
      "patterns": [
        { "include": "source.css" }
      ]
    }
  }
}