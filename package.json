{
  "name": "nodula-framework",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": false,
  "files": [
    "dist/framework"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "types": "dist/framework/nodula-framework.d.ts",
  "exports": {
    ".": {
      "types": "./dist/framework/nodula-framework.d.ts",
      "import": "./dist/framework/nodula-framework.js"
    },
    "./nodula-framework.css": "./dist/framework/nodula-framework.css",
    "./dialog.css": "./dist/framework/nodula-dialog.css",
    "./modal.css": "./dist/framework/nodula-modal.css",
    "./drawer.css": "./dist/framework/nodula-drawer.css",
    "./notifications.css": "./dist/framework/nodula-notifications.css",
    "./dialog": {
      "types": "./dist/framework/nodula-dialog.d.ts",
      "import": "./dist/framework/nodula-dialog.js"
    },
    "./notifications": {
      "types": "./dist/framework/nodula-notifications.d.ts",
      "import": "./dist/framework/nodula-notifications.js"
    },
    "./form": {
      "types": "./dist/framework/nodula-form.d.ts",
      "import": "./dist/framework/nodula-form.js"
    },
    "./router": {
      "types": "./dist/framework/nodula-router.d.ts",
      "import": "./dist/framework/nodula-router.js"
    },
    "./animation": {
      "types": "./dist/framework/nodula-animation.d.ts",
      "import": "./dist/framework/nodula-animation.js"
    },
    "./modal": {
      "types": "./dist/framework/nodula-modal.d.ts",
      "import": "./dist/framework/nodula-modal.js"
    },
    "./drawer": {
      "types": "./dist/framework/nodula-drawer.d.ts",
      "import": "./dist/framework/nodula-drawer.js"
    },
    "./navigation": {
      "types": "./dist/framework/nodula-navigation.d.ts",
      "import": "./dist/framework/nodula-navigation.js"
    },
    "./localstorage": {
      "types": "./dist/framework/nodula-localstorage.d.ts",
      "import": "./dist/framework/nodula-localstorage.js"
    },
    "./data": {
      "types": "./dist/framework/nodula-data.d.ts",
      "import": "./dist/framework/nodula-data.js"
    },
    "./store": {
      "types": "./dist/framework/nodula-store.d.ts",
      "import": "./dist/framework/nodula-store.js"
    },
    "./pwa": {
      "types": "./dist/framework/nodula-pwa.d.ts",
      "import": "./dist/framework/nodula-pwa.js"
    }
  },
  "scripts": {
    "dev": "npm run install:framework && npm --prefix 'demo app' run dev",
    "build": "npm run install:framework && npm run build:app && npm run typecheck:bundle && npm run pack:framework",
    "build:app": "npm --prefix 'demo app' run build",
    "build:form": "vite build --config vite.config.js --mode addon-form",
    "build:router": "vite build --config vite.config.js --mode addon-router",
    "build:animation": "vite build --config vite.config.js --mode addon-animation",
    "build:dialog": "vite build --config vite.config.js --mode addon-dialog",
    "build:notifications": "vite build --config vite.config.js --mode addon-notifications",
    "build:modal": "vite build --config vite.config.js --mode addon-modal",
    "build:drawer": "vite build --config vite.config.js --mode addon-drawer",
    "build:navigation": "vite build --config vite.config.js --mode addon-navigation",
    "build:localstorage": "vite build --config vite.config.js --mode addon-localstorage",
    "build:data": "vite build --config vite.config.js --mode addon-data",
    "build:pwa": "vite build --config vite.config.js --mode addon-pwa",
    "build:store": "vite build --config vite.config.js --mode addon-store",
    "build:framework": "vite build --config vite.config.js --mode framework && npm run build:store && npm run build:form && npm run build:router && npm run build:animation && npm run build:dialog && npm run build:notifications && npm run build:modal && npm run build:drawer && npm run build:navigation && npm run build:localstorage && npm run build:data && npm run build:pwa",
    "package:framework": "npm run build:framework && npm run pack:framework",
    "pack:framework": "npm pack --pack-destination dist/npm",
    "install:framework": "npm run package:framework && npm install --prefix 'demo app' ./dist/npm/nodula-framework-0.1.0.tgz",
    "test": "npm run typecheck && npm run install:framework && node --test && npm run test:api",
    "typecheck": "npm run build:framework && tsc -p config/tsconfig.types.json",
    "typecheck:bundle": "tsc --strict --noEmit --skipLibCheck false --target ES2022 --module ESNext --moduleResolution Bundler --lib ES2022,DOM,DOM.Iterable --types node tests/types/bundle.typecheck.ts"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "lightningcss": "^1.33.0",
    "parse5": "^7.3.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "vite-plugin-pwa": {
      "optional": true
    }
  },
  "peerDependencies": {
    "vite-plugin-pwa": "^1.3.0"
  }
}
