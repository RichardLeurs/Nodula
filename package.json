{
  "name": "nodula-framework",
  "version": "0.1.0",
  "private": false,
  "license": "GPL-3.0-or-later",
  "files": [
    "dist/nodula"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "dist/nodula/nodula-core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/nodula/nodula-core.d.ts",
      "import": "./dist/nodula/nodula-core.js"
    },
    "./dialog.css": "./dist/nodula/css/nodula-dialog.css",
    "./modal.css": "./dist/nodula/css/nodula-modal.css",
    "./drawer.css": "./dist/nodula/css/nodula-drawer.css",
    "./notifications.css": "./dist/nodula/css/nodula-notifications.css",
    "./cookieconsent.css": "./dist/nodula/css/nodula-cookieconsent.css",
    "./filedrop.css": "./dist/nodula/css/nodula-filedrop.css",
    "./sortable.css": "./dist/nodula/css/nodula-sortable.css",
    "./vite": {
      "types": "./dist/nodula/nodula-vite.d.ts",
      "import": "./dist/nodula/nodula-vite.js"
    },
    "./dialog": {
      "types": "./dist/nodula/nodula-dialog.d.ts",
      "import": "./dist/nodula/nodula-dialog.js"
    },
    "./notification": {
      "types": "./dist/nodula/nodula-notification.d.ts",
      "import": "./dist/nodula/nodula-notification.js"
    },
    "./cookieconsent": {
      "types": "./dist/nodula/nodula-cookieconsent.d.ts",
      "import": "./dist/nodula/nodula-cookieconsent.js"
    },
    "./form": {
      "types": "./dist/nodula/nodula-form.d.ts",
      "import": "./dist/nodula/nodula-form.js"
    },
    "./router": {
      "types": "./dist/nodula/nodula-router.d.ts",
      "import": "./dist/nodula/nodula-router.js"
    },
    "./animation": {
      "types": "./dist/nodula/nodula-animation.d.ts",
      "import": "./dist/nodula/nodula-animation.js"
    },
    "./modal": {
      "types": "./dist/nodula/nodula-modal.d.ts",
      "import": "./dist/nodula/nodula-modal.js"
    },
    "./drawer": {
      "types": "./dist/nodula/nodula-drawer.d.ts",
      "import": "./dist/nodula/nodula-drawer.js"
    },
    "./navigation": {
      "types": "./dist/nodula/nodula-navigation.d.ts",
      "import": "./dist/nodula/nodula-navigation.js"
    },
    "./navigation-dropdown": {
      "types": "./dist/nodula/nodula-navigation-dropdown.d.ts",
      "import": "./dist/nodula/nodula-navigation-dropdown.js"
    },
    "./dragdrop": {
      "types": "./dist/nodula/nodula-dragdrop.d.ts",
      "import": "./dist/nodula/nodula-dragdrop.js"
    },
    "./sortable": {
      "types": "./dist/nodula/nodula-sortable.d.ts",
      "import": "./dist/nodula/nodula-sortable.js"
    },
    "./resource": {
      "types": "./dist/nodula/nodula-resource.d.ts",
      "import": "./dist/nodula/nodula-resource.js"
    },
    "./filedrop": {
      "types": "./dist/nodula/nodula-filedrop.d.ts",
      "import": "./dist/nodula/nodula-filedrop.js"
    },
    "./fileupload": {
      "types": "./dist/nodula/nodula-fileupload.d.ts",
      "import": "./dist/nodula/nodula-fileupload.js"
    },
    "./localstorage": {
      "types": "./dist/nodula/nodula-localstorage.d.ts",
      "import": "./dist/nodula/nodula-localstorage.js"
    },
    "./data": {
      "types": "./dist/nodula/nodula-data.d.ts",
      "import": "./dist/nodula/nodula-data.js"
    },
    "./store": {
      "types": "./dist/nodula/nodula-store.d.ts",
      "import": "./dist/nodula/nodula-store.js"
    },
    "./pwa": {
      "types": "./dist/nodula/nodula-pwa.d.ts",
      "import": "./dist/nodula/nodula-pwa.js"
    },
    "./auth": {
      "types": "./dist/nodula/nodula-auth.d.ts",
      "import": "./dist/nodula/nodula-auth.js"
    },
    "./seo": {
      "types": "./dist/nodula/nodula-seo.d.ts",
      "import": "./dist/nodula/nodula-seo.js"
    },
    "./seo-vite": {
      "types": "./dist/nodula/nodula-seo-vite.d.ts",
      "import": "./dist/nodula/nodula-seo-vite.js"
    }
  },
  "scripts": {
    "dev": "npm run install:framework && npm --prefix demo_app run dev",
    "dev:api": "php -S localhost:8787 -t . api/database/index.php",
    "dev:upload": "php -S localhost:8787 -t . api/upload/index.php",
    "build": "npm run package:framework && npm run install:framework:package && npm run typecheck:bundle && npm run build:app && npm run build:docs",
    "build_test": "npm run test:framework && npm run package:framework && npm run install:framework:package && npm run typecheck:bundle && npm run test:demo && npm run build:app && npm run build:docs",
    "build:app": "npm --prefix demo_app run build",
    "build:docs": "node vitepress/build-docs.mjs",
    "build:compiler": "vite build --config framework/vite.config.js --mode compiler",
    "build:form": "vite build --config framework/vite.config.js --mode addon-form",
    "build:router": "vite build --config framework/vite.config.js --mode addon-router",
    "build:animation": "vite build --config framework/vite.config.js --mode addon-animation",
    "build:dialog": "vite build --config framework/vite.config.js --mode addon-dialog",
    "build:notification": "vite build --config framework/vite.config.js --mode addon-notification",
    "build:cookieconsent": "vite build --config framework/vite.config.js --mode addon-cookieconsent",
    "build:modal": "vite build --config framework/vite.config.js --mode addon-modal",
    "build:drawer": "vite build --config framework/vite.config.js --mode addon-drawer",
    "build:navigation": "vite build --config framework/vite.config.js --mode addon-navigation",
    "build:navigation-dropdown": "vite build --config framework/vite.config.js --mode addon-navigation-dropdown",
    "build:dragdrop": "vite build --config framework/vite.config.js --mode addon-dragdrop",
    "build:sortable": "vite build --config framework/vite.config.js --mode addon-sortable",
    "build:filedrop": "vite build --config framework/vite.config.js --mode addon-filedrop",
    "build:fileupload": "vite build --config framework/vite.config.js --mode addon-fileupload",
    "build:localstorage": "vite build --config framework/vite.config.js --mode addon-localstorage",
    "build:data": "vite build --config framework/vite.config.js --mode addon-data",
    "build:resource": "vite build --config framework/vite.config.js --mode addon-resource",
    "build:pwa": "vite build --config framework/vite.config.js --mode addon-pwa",
    "build:store": "vite build --config framework/vite.config.js --mode addon-store",
    "build:auth": "vite build --config framework/vite.config.js --mode addon-auth",
    "build:seo": "vite build --config framework/vite.config.js --mode addon-seo",
    "build:seo-vite": "vite build --config framework/vite.config.js --mode addon-seo-vite",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt 'framework/**/*.{js,mjs,cjs,ts,tsx,jsx,json,css,md}' 'demo_app/src/**/*.{js,mjs,cjs,ts,tsx,jsx,json,css,md}' 'demo_app/vite.config.js' 'vitepress/docs/guide/**/*.md' 'vitepress/docs/.vitepress/config.mjs' 'vitepress/vite.config.js' 'vite.config.js' 'package.json'",
    "format:check": "oxfmt --check 'framework/**/*.{js,mjs,cjs,ts,tsx,jsx,json,css,md}' 'demo_app/src/**/*.{js,mjs,cjs,ts,tsx,jsx,json,css,md}' 'demo_app/vite.config.js' 'vitepress/docs/guide/**/*.md' 'vitepress/docs/.vitepress/config.mjs' 'vitepress/vite.config.js' 'vite.config.js' 'package.json'",
    "build:framework": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist/nodula', { recursive: true, force: true });\" && vite build --config framework/vite.config.js --mode framework && npm run build:compiler && npm run build:store && npm run build:form && npm run build:router && npm run build:animation && npm run build:dialog && npm run build:notification && npm run build:cookieconsent && npm run build:modal && npm run build:drawer && npm run build:navigation && npm run build:navigation-dropdown && npm run build:dragdrop && npm run build:sortable && npm run build:filedrop && npm run build:fileupload && npm run build:localstorage && npm run build:data && npm run build:resource && npm run build:pwa && npm run build:auth && npm run build:seo && npm run build:seo-vite && node framework/mjs/gzip-framework.mjs",
    "package:framework": "npm run build:framework && npm run pack:framework",
    "pack:framework": "mkdir -p dist/npm && npm pack --pack-destination dist/npm",
    "install:framework": "npm run package:framework && npm run install:framework:package",
    "install:framework:package": "npm install --prefix demo_app ./dist/npm/nodula-framework-0.1.0.tgz",
    "test": "npm run typecheck && npm run test:framework && npm run test:demo",
    "benchmark:render": "node framework/mjs/render-benchmark.mjs",
    "test:framework": "vitest run --config framework/vitest.config.js",
    "test:framework:watch": "vitest --config framework/vitest.config.js",
    "test:demo": "npm --prefix demo_app run test",
    "test:a11y": "playwright test --config playwright.config.js",
    "typecheck": "npm run build:framework && tsc -p tsconfig.types.json",
    "typecheck:bundle": "tsc --strict --noEmit --skipLibCheck false --target ES2022 --module ESNext --moduleResolution Bundler --lib ES2022,DOM,DOM.Iterable --types node framework/vitest/types/bundle.typecheck.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "axe-core": "^4.14.0",
    "happy-dom": "^20.14.5",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "parse5": "^7.3.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "vite-plugin-pwa": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
